
# =====================================
# AI DEVELOPERS TEAMS — AI CONFIGURATION
# =====================================

APP_NAME=AI Developers Teams
APP_ENV=development
DEBUG=true

# Провайдер ИИ
AI_PROVIDER=openai

# Адрес API
AI_BASE_URL=https://api.openai.com/v1

# Название модели
AI_MODEL=gpt-4o-mini

# Секретный API-ключ
AI_API_KEY=ВСТАВЬ_СЮДА_СВОЙ_API_KEY

# Память
AGENT_MEMORY_ENABLED=true

# Количество параллельных агентов
MAX_PARALLEL_AGENTS=3

# Безопасность
REQUIRE_APPROVAL_FOR_CODE_CHANGES=true
REQUIRE_APPROVAL_FOR_AGENT_MODIFICATIONS=true
AUTO_ROLLBACK_ON_CRITICAL_ERROR=true

# База данных
DATABASE_PATH=/app/data/ai_developers.db
