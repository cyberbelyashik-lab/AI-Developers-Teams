
# Application
APP_NAME=AI Developers Teams
APP_ENV=development
DEBUG=true

# AI provider
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=

# Database
DATABASE_PATH=data/ai_developers.db

# Agents
MAX_PARALLEL_AGENTS=3
AGENT_MEMORY_ENABLED=true

# Safety
REQUIRE_APPROVAL_FOR_CODE_CHANGES=true
REQUIRE_APPROVAL_FOR_AGENT_MODIFICATIONS=true
AUTO_ROLLBACK_ON_CRITICAL_ERROR=true
